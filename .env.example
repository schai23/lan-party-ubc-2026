# Sidekick: single root .env read by server, runner, scripts (packages/shared/src/config.ts)
# and by Vite at build time (envDir = repo root). Everything is optional: with an empty .env
# the app runs with honest stubs. Run `pnpm check:config` to see what is live.

# ---------- Server / hosting ----------
PORT=8787                          # Railway sets this automatically
PUBLIC_BASE_URL=                   # Railway public domain, e.g. https://sidekick-production.up.railway.app
DB_PATH=                           # default apps/server/data/sidekick.sqlite (use a Railway volume path in prod)
LAN_MODE=                          # 1 = QR codes use this machine's LAN IP when PUBLIC_BASE_URL is empty
DEV_TOOLS=                         # 1 = enable POST /dev/replay-tx (never in prod)

# ---------- Solana (devnet) ----------
SOLANA_RPC_URL=                    # QuickNode dashboard > Solana Devnet endpoint (HTTP URL), or https://api.devnet.solana.com
SOLANA_WS_URL=                     # same endpoint, WSS URL
PROGRAM_ID=                        # anchor/PROGRAM_ID.txt (generated by `anchor keys sync`), deployed with `anchor deploy`
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU   # Circle devnet USDC
SETTLER_KEYPAIR=                   # JSON array from `solana-keygen new -o settler.json` (cat settler.json). Pays fees, signs settle.
TREASURY_KEYPAIR=                  # JSON array from `solana-keygen new -o treasury.json`. Funds sessions with USDC from faucet.circle.com
SESSION_BUDGET_USDC=5              # USDC moved into each session vault

# ---------- QuickNode Streams ----------
QUICKNODE_STREAM_TOKEN=            # any long random string; set the same value as header x-qn-token on the Stream destination

# ---------- ElevenLabs ----------
ELEVENLABS_API_KEY=                # elevenlabs.io > Settings > API Keys
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5   # low-latency streaming TTS model
ELEVENLABS_STT_MODEL=scribe_v1     # speech-to-text model
VOICE_ID_INNKEEPER=                # elevenlabs.io > Voices > pick voice > copy Voice ID
VOICE_ID_BLACKSMITH=               # same
VOICE_ID_ORACLE=                   # same

# ---------- Grok Bot / admin ----------
ADMIN_TOKEN=                       # any random string (openssl rand -hex 16); random per boot if empty
GROK_TOKEN=                        # any random string given to Grok Bot; random per boot if empty

# ---------- Privy ----------
PRIVY_APP_ID=                      # dashboard.privy.io > App settings > App ID
PRIVY_APP_SECRET=                  # optional, dashboard.privy.io > App settings > secret

# ---------- Web (build time, injected by Vite) ----------
VITE_SERVER_URL=                   # leave empty when the server serves the web build (same origin)
VITE_PRIVY_APP_ID=                 # same value as PRIVY_APP_ID; enables real embedded wallets on /helper
VITE_LOCAL_OLLAMA_URL=http://localhost:11434   # host's own Ollama for unlinked mode (needs OLLAMA_ORIGINS=*)

# ---------- Runner (helper laptops) ----------
SIDEKICK_SERVER=                   # public server URL (same as PUBLIC_BASE_URL)
SIDEKICK_TOKEN=                    # helper token shown on /helper after login
OLLAMA_HOST=http://127.0.0.1:11434
DIALOGUE_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
